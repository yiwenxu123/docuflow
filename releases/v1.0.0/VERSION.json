{
  "version": "1.0.0",
  "release_date": "2025-08-02T12:15:33.165896",
  "description": "DocuFlow 1.0 稳定版本",
  "features": [
    "支持多种文档格式转换",
    "Web界面操作",
    "命令行工具",
    "图形界面",
    "批量转换功能",
    "自定义转换参数",
    "下载文件名修复"
  ],
  "supported_formats": {
    "input": [
      ".pdf",
      ".docx",
      ".doc",
      ".txt",
      ".md",
      ".html",
      ".xlsx",
      ".xls",
      ".pptx",
      ".ppt"
    ],
    "output": [
      ".pdf",
      ".docx",
      ".html",
      ".txt",
      ".md",
      ".xlsx",
      ".pptx"
    ]
  },
  "requirements": {
    "python": ">=3.7",
    "system": "Windows/macOS/Linux"
  }
}